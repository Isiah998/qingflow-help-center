GITHUB_EDIT_URL=https://github.com/qingflow/help-center/tree/main/
# Outline is the production content source. Keep the token in a secret store.
OUTLINE_URL=https://outline.qingflow.com
OUTLINE_COLLECTION=售后知识库(公开)
OUTLINE_API_TOKEN=replace-with-read-only-token
DOCS_CONTENT_SOURCE=outline
# Server-side address used by index administration commands.
TYPESENSE_HOST=http://localhost:8108
# Browser-visible search endpoint. The K8s image defaults this to /typesense.
TYPESENSE_SEARCH_HOST=http://localhost:8108
TYPESENSE_COLLECTION=qingflow_help_docs
TYPESENSE_SEARCH_API_KEY=replace-with-search-key
TYPESENSE_ADMIN_API_KEY=replace-with-admin-key
TYPESENSE_ENABLE_SEMANTIC=false
